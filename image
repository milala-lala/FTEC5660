<svg xmlns="http://www.w3.org/2000/svg" width="1500" height="1120" viewBox="0 0 1500 1120" role="img" aria-labelledby="title description">
  <title id="title">FTEC5660 Homework 1 receipt processing flow</title>
  <desc id="description">A color flowchart of build_chain and answer_queries, from receipt images through JSON extraction and Decimal validation to both totals and results.csv.</desc>
  <defs>
    <marker id="arrow" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto">
      <path d="M1,1 L11,6 L1,11 Z" fill="#64748b" />
    </marker>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#0f172a" flood-opacity="0.08" />
    </filter>
  </defs>

  <rect width="1500" height="1120" rx="28" fill="#f8fafc" />
  <text x="64" y="66" font-family="Arial, sans-serif" font-size="34" font-weight="700" fill="#172554">From receipt images to two checked totals</text>
  <text x="64" y="102" font-family="Arial, sans-serif" font-size="19" fill="#475569">How build_chain() prepares vision extraction and answer_queries() validates and sums the results</text>

  <!-- Main image-to-JSON path -->
  <g filter="url(#shadow)">
    <rect x="50" y="145" width="250" height="220" rx="20" fill="#eaf2ff" stroke="#3b82f6" stroke-width="2" />
    <circle cx="83" cy="180" r="19" fill="#3b82f6" />
    <text x="83" y="187" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#ffffff">1</text>
    <text x="112" y="186" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#1e3a8a">Receipt images</text>
    <text x="76" y="231" font-family="Arial, sans-serif" font-size="17" fill="#334155">All supported images from</text>
    <text x="76" y="258" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#334155">public_test/ or another folder</text>
    <text x="76" y="310" font-family="Arial, sans-serif" font-size="15" fill="#64748b">One image is handled per call</text>

    <rect x="340" y="145" width="265" height="220" rx="20" fill="#e7fbf7" stroke="#14b8a6" stroke-width="2" />
    <circle cx="373" cy="180" r="19" fill="#0f9f91" />
    <text x="373" y="187" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#ffffff">2</text>
    <text x="402" y="186" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#115e59">Encode the image</text>
    <text x="366" y="231" font-family="Arial, sans-serif" font-size="17" fill="#334155">image_data_url(path)</text>
    <text x="366" y="261" font-family="Arial, sans-serif" font-size="17" fill="#334155">creates a Base64 data URL</text>
    <rect x="366" y="292" width="214" height="39" rx="10" fill="#ffffff" opacity="0.85" />
    <text x="473" y="317" text-anchor="middle" font-family="Consolas, monospace" font-size="14" fill="#0f766e">data:image/...;base64,…</text>

    <rect x="650" y="145" width="390" height="220" rx="20" fill="#f1eafe" stroke="#8b5cf6" stroke-width="2" />
    <circle cx="683" cy="180" r="19" fill="#7c3aed" />
    <text x="683" y="187" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#ffffff">3</text>
    <text x="712" y="186" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#4c1d95">build_chain()</text>
    <text x="676" y="231" font-family="Arial, sans-serif" font-size="17" fill="#334155">ChatPromptTemplate + ChatDeepSeek</text>
    <text x="676" y="261" font-family="Arial, sans-serif" font-size="16" fill="#334155">Model: deepseek-v4-flash-vision-exp</text>
    <text x="676" y="310" font-family="Arial, sans-serif" font-size="15" fill="#6d28d9">Prompt requests only the required fields</text>

    <rect x="1085" y="145" width="365" height="220" rx="20" fill="#fff5e8" stroke="#f59e0b" stroke-width="2" />
    <circle cx="1118" cy="180" r="19" fill="#ea8a08" />
    <text x="1118" y="187" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" font-weight="700" fill="#ffffff">4</text>
    <text x="1147" y="186" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#92400e">Structured JSON</text>
    <text x="1111" y="231" font-family="Consolas, monospace" font-size="15" fill="#334155">final_payment_hkd</text>
    <text x="1111" y="261" font-family="Consolas, monospace" font-size="15" fill="#334155">subtotal_hkd</text>
    <text x="1111" y="291" font-family="Consolas, monospace" font-size="15" fill="#334155">discounts_hkd[]</text>
    <text x="1111" y="330" font-family="Arial, sans-serif" font-size="14" fill="#92400e">ROUNDING is not a discount</text>
  </g>

  <path d="M300 255 H331" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />
  <path d="M605 255 H641" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />
  <path d="M1040 255 H1076" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />

  <!-- Shared parsing and validation -->
  <path d="M1267 365 V410 H750 V438" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />
  <g filter="url(#shadow)">
    <rect x="320" y="450" width="860" height="150" rx="20" fill="#eef2f7" stroke="#64748b" stroke-width="2" />
    <text x="750" y="489" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="700" fill="#1e293b">answer_queries(chain, images)</text>
    <text x="750" y="525" text-anchor="middle" font-family="Arial, sans-serif" font-size="17" fill="#334155">Parse JSON, validate each amount, and convert values to Decimal</text>
    <text x="750" y="559" text-anchor="middle" font-family="Arial, sans-serif" font-size="15" fill="#64748b">Malformed or unreadable values stop with the receipt filename for diagnosis</text>
  </g>

  <!-- Split into the two required calculations -->
  <path d="M750 600 V638 H380 V676" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />
  <path d="M750 600 V638 H1120 V676" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />
  <g filter="url(#shadow)">
    <rect x="80" y="690" width="600" height="205" rx="20" fill="#eafaf1" stroke="#10b981" stroke-width="2" />
    <text x="112" y="732" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#065f46">Question 1 · Actual amount spent</text>
    <text x="112" y="772" font-family="Consolas, monospace" font-size="19" fill="#134e4a">sum(final_payment_hkd)</text>
    <text x="112" y="807" font-family="Arial, sans-serif" font-size="16" fill="#334155">Uses each receipt's final payment after ROUNDING.</text>
    <rect x="112" y="830" width="210" height="42" rx="11" fill="#ffffff" />
    <text x="217" y="858" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="700" fill="#047857">HK$ amount</text>

    <rect x="820" y="690" width="600" height="205" rx="20" fill="#fff4e9" stroke="#f97316" stroke-width="2" />
    <text x="852" y="732" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#9a3412">Question 2 · Before discounts</text>
    <text x="852" y="772" font-family="Consolas, monospace" font-size="19" fill="#7c2d12">sum(subtotal_hkd + discounts_hkd)</text>
    <text x="852" y="807" font-family="Arial, sans-serif" font-size="16" fill="#334155">Adds every discount back; excludes ROUNDING.</text>
    <rect x="852" y="830" width="210" height="42" rx="11" fill="#ffffff" />
    <text x="957" y="858" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="700" fill="#c2410c">HK$ amount</text>
  </g>

  <!-- Provided runner output -->
  <path d="M380 895 V925 H750 V950" fill="none" stroke="#64748b" stroke-width="3" marker-end="url(#arrow)" />
  <path d="M1120 895 V925 H750" fill="none" stroke="#64748b" stroke-width="3" />
  <g filter="url(#shadow)">
    <rect x="370" y="960" width="760" height="115" rx="20" fill="#eaf2ff" stroke="#3b82f6" stroke-width="2" />
    <text x="750" y="1002" text-anchor="middle" font-family="Arial, sans-serif" font-size="21" font-weight="700" fill="#1e3a8a">Provided runner writes results.csv</text>
    <text x="750" y="1037" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#334155">Two exact query rows · correctness checked against ground_truth.json when present</text>
  </g>
</svg>
